<UserControl x:Class="TesseractEditor.GameProject.OpenProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TesseractEditor.GameProject"
             mc:Ignorable="d" Width="800"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <local:OpenProject/>
    </UserControl.DataContext>
    <StackPanel Background="White">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <ListBox Width="200" Height="240" ItemsSource="{Binding Projects}" x:Name="ProjectsListBox"
            SelectedIndex="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <EventSetter Event="MouseDoubleClick" Handler="OnListBoxItem_Double_Click"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding ProjectName}" FontFamily="Agency FB" FontSize="24" Padding="0, 10, 0, 10"></TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>
            <Border Width="400" Height="240" Margin="5, 0, 0, 0">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Path=SelectedItem.Screenshot, ElementName=ProjectsListBox}"></ImageBrush>
                </Border.Background>
            </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0, 10, 0, 0">
            <TextBlock Text="Path" FontSize="18" FontFamily="Agency FB" Width="50"/>
            <TextBox Width="500" Margin="10, 0, 0, 0"></TextBox>
            <Button Content="Browse" FontFamily="Agency FB" Width="40" Margin="10, 0, 0, 0"/>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" Margin="0, 10, 95, 0" HorizontalAlignment="Right" >
            <Button Content="Open" FontSize="18" FontFamily="Agency FB" Padding="10, 5" IsDefault="True" Click="On_Open_Button_Click"/>
            <Button Content="Cancel" FontSize="18" FontFamily="Agency FB" Padding="10, 5" Margin="10, 0, 0, 0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</UserControl>
